# Native build (Linux/macOS: .so, Windows/MinGW: .dll)
CXX ?= g++
EXE ?= libffish.so
IMPLIB :=
OS_NAME := $(OS)
ifeq ($(OS_NAME),)
  OS_NAME := $(shell uname -s)
endif
ifneq (,$(findstring MINGW,$(OS_NAME)))
  EXE := ffish.dll
  IMPLIB := libffish.dll.a
endif
ifeq ($(OS_NAME),Windows_NT)
  EXE := ffish.dll
  IMPLIB := libffish.dll.a
endif

SRCS = ffishdll.cpp benchmark.cpp bitbase.cpp bitboard.cpp endgame.cpp evaluate.cpp \
	material.cpp misc.cpp movegen.cpp movepick.cpp pawns.cpp position.cpp psqt.cpp \
	search.cpp thread.cpp timeman.cpp tt.cpp uci.cpp ucioption.cpp tune.cpp syzygy/tbprobe.cpp \
	nnue/evaluate_nnue.cpp \
	partner.cpp parser.cpp piece.cpp variant.cpp apiutil.cpp xboard.cpp \
	nnue/features/half_ka_v2_variants.cpp

largeboards ?= yes
verylargeboards ?= no

CXXFLAGS ?= -O3 -DNDEBUG
CXXFLAGS += -std=c++17 -Wall -Wextra -DALLVARS -DNNUE_EMBEDDING_OFF $(EXTRACXXFLAGS)
include board-size.mk
ifeq ($(boardbits),128)
  CXXFLAGS += -DPRECOMPUTED_MAGICS
endif
LDFLAGS ?= -shared
ifneq (,$(filter $(OS_NAME),Linux Darwin))
  CXXFLAGS += -fPIC -pthread
endif
ifneq ($(IMPLIB),)
  LDFLAGS += -Wl,--out-implib,$(IMPLIB)
endif
# Match the compiler target, including flags such as -m32. Fail if the
# compiler cannot report a supported pointer width.
DLL_POINTER_BYTES := $(shell printf '' | $(CXX) $(CPPFLAGS) $(CXXFLAGS) -dM -E -x c++ - 2>&1 | sed -n 's/^\#define __SIZEOF_POINTER__ //p')
ifeq ($(strip $(DLL_POINTER_BYTES)),8)
  CXXFLAGS += -DIS_64BIT
else ifneq ($(strip $(DLL_POINTER_BYTES)),4)
  $(error Could not determine DLL compiler pointer width (expected 4 or 8 bytes, got '$(strip $(DLL_POINTER_BYTES))'))
endif
override CXXFLAGS += $(BOARD_SIZE_CXXFLAGS)

DLL_BUILD_DIR ?= ../.local/build/dll/$(boardbits)
OBJS := $(addprefix $(DLL_BUILD_DIR)/,$(SRCS:.cpp=.o))
CONFIG := $(DLL_BUILD_DIR)/config
LINK_CONFIG := $(EXE).link-config

.PHONY: all clean FORCE
all: $(EXE)

$(CONFIG): FORCE
	@mkdir -p $(@D)
	@printf '%s\n' '$(CXX)' '$(CPPFLAGS)' '$(CXXFLAGS)' '$(LDFLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

$(LINK_CONFIG): $(CONFIG) FORCE
	@mkdir -p $(@D)
	@printf '%s\n' '$(OBJS)' > $@.tmp
	@cat $(CONFIG) >> $@.tmp
	@cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

$(EXE): $(OBJS) $(LINK_CONFIG)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS)

$(DLL_BUILD_DIR)/%.o: %.cpp $(CONFIG)
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(OBJS:.o=.d)

clean:
	rm -f $(OBJS) $(OBJS:.o=.d) $(CONFIG) $(LINK_CONFIG) $(EXE) $(IMPLIB)
